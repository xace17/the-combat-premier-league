* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #080b10;
    color: #ffffff;
}


/* NAVIGATION */

nav {
    height: 68px;

    background: #0d1117;

    border-bottom: 1px solid #222a35;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 5%;

    position: sticky;
    top: 0;

    z-index: 1000;
}

.logo {
    color: #ffffff;

    font-size: 21px;

    font-weight: 800;

    letter-spacing: 1px;

    text-decoration: none;
}

.logo span {
    color: #5cff8d;
}

.nav-links {
    display: flex;

    align-items: center;

    gap: 25px;

    list-style: none;
}

.nav-links a {
    color: #aeb7c2;

    text-decoration: none;

    font-size: 14px;

    font-weight: 600;

    transition: 0.2s;
}

.nav-links a:hover {
    color: #5cff8d;
}

.discord {
    background: #5865f2;

    color: white !important;

    padding: 9px 16px;

    border-radius: 6px;
}


/* HERO */

.hero {
    min-height: 75vh;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    padding: 60px 20px;

    background:
        radial-gradient(
            circle at 50% 25%,
            #173c25,
            #080b10 65%
        );
}

.hero-content {
    max-width: 850px;
}

.small-title,
.section-label {
    color: #5cff8d;

    font-size: 12px;

    font-weight: 800;

    letter-spacing: 2px;
}

.hero h1 {
    font-size: clamp(48px, 8vw, 82px);

    line-height: 0.98;

    letter-spacing: -4px;

    margin: 18px 0 25px;
}

.hero h1 span {
    color: #5cff8d;
}

.hero-text {
    max-width: 650px;

    margin: auto;

    color: #98a2ae;

    font-size: 17px;

    line-height: 1.7;
}

.buttons {
    margin-top: 30px;
}

.btn {
    display: inline-block;

    padding: 13px 23px;

    margin: 5px;

    border-radius: 6px;

    background: #5cff8d;

    color: #07100a;

    text-decoration: none;

    font-weight: 700;

    transition: 0.2s;
}

.btn:hover {
    transform: translateY(-2px);
}

.btn.dark {
    background: #151b23;

    color: white;

    border: 1px solid #29323d;
}


/* SECTIONS */

.section {
    padding: 80px 0;
}

.container {
    width: 88%;

    max-width: 1150px;

    margin: auto;
}

.section-title {
    margin-bottom: 35px;
}

.section-title h2 {
    font-size: 36px;

    margin: 8px 0;
}

.section-title > p:last-child {
    color: #818b97;

    line-height: 1.6;
}


/* PVP MODE CARDS */

.modes {
    display: grid;

    grid-template-columns:
        repeat(5, 1fr);

    gap: 15px;
}

.mode-card {
    min-height: 210px;

    padding: 23px;

    background: #10151d;

    border: 1px solid #222a35;

    border-radius: 10px;

    color: white;

    text-decoration: none;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

    transition: 0.25s;
}

.mode-card:hover {
    transform: translateY(-6px);

    border-color: #5cff8d;

    background: #131b21;
}

.mode-number {
    color: #59636f;

    font-size: 13px;

    font-weight: 700;
}

.mode-card h3 {
    font-size: 25px;

    margin-bottom: 6px;
}

.mode-card p {
    color: #7f8995;

    font-size: 13px;
}

.arrow {
    color: #5cff8d;

    font-size: 22px;

    align-self: flex-end;
}


/* LEADERBOARD */

.leaderboard {
    background: #0e131a;

    border: 1px solid #222a35;

    border-radius: 9px;

    overflow: hidden;
}

.leader-row {
    display: grid;

    grid-template-columns:
        70px
        1fr
        120px
        100px;

    padding: 18px 20px;

    border-bottom: 1px solid #202733;

    align-items: center;
}

.leader-row:last-child {
    border-bottom: none;
}

.leader-head {
    background: #141a22;

    color: #5cff8d;

    font-size: 13px;
}

.rank {
    color: #7d8793;

    font-weight: 700;
}

.player {
    font-weight: 700;
}

.points {
    color: #5cff8d;

    font-weight: 700;
}


/* DISCORD */

.discord-box {
    max-width: 800px;

    margin: auto;

    padding: 55px 25px;

    text-align: center;

    background: #10151d;

    border: 1px solid #222a35;

    border-radius: 12px;
}

.discord-box h2 {
    font-size: 36px;

    margin: 10px 0;
}

.discord-box > p:not(.section-label) {
    color: #89939f;

    line-height: 1.6;

    margin-bottom: 25px;
}


/* FOOTER */

footer {
    border-top: 1px solid #202733;

    text-align: center;

    padding: 30px;

    color: #626c78;

    font-size: 13px;
}


/* TABLET */

@media (max-width: 950px) {

    .modes {
        grid-template-columns:
            repeat(3, 1fr);
    }

}


/* MOBILE */

@media (max-width: 650px) {

    nav {
        height: auto;

        padding: 14px 4%;

        flex-direction: column;

        gap: 14px;
    }

    .nav-links {
        gap: 12px;

        flex-wrap: wrap;

        justify-content: center;
    }

    .nav-links a {
        font-size: 12px;
    }

    .hero {
        min-height: 65vh;
    }

    .hero h1 {
        font-size: 48px;

        letter-spacing: -2px;
    }

    .modes {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .mode-card {
        min-height: 180px;
    }

    .leader-row {
        grid-template-columns:
            45px
            1fr
            80px;

        padding: 15px 12px;
    }

    .leader-row .wins {
        display: none;
    }

}


/* SMALL PHONES */

@media (max-width: 400px) {

    .modes {
        grid-template-columns: 1fr;
    }

    .mode-card {
        min-height: 150px;
    }

}
